{% extends 'base.html.twig' %}

{% block title %}{{ 'app.edit_idea'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="form-container" 
     data-controller="live-rating-preview" 
     data-action="change->live-rating-preview#update"
     data-live-rating-preview-weights-value="{{ app.user.preferences ? app.user.preferences|json_encode : '{}' }}">
    
    <div class="form-header">
        <a href="{{ path('app_home') }}" class="btn-back">{{ 'app.back'|trans }}</a>
        <h1>{{ 'app.edit_idea'|trans }}</h1>
        <p class="form-subtitle">{{ 'edit_idea.subtitle'|trans }}</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'standard-form', 'enctype': 'multipart/form-data'}}) }}
        <div class="form-card">
            <h2>{{ 'idea.details_project'|trans }}</h2>

            <div class="form-group">
                {{ form_label(form.title) }}
                {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'idea.title.placeholder'|trans}}) }}
                {{ form_errors(form.title) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description) }}

                <div class="markdown-toolbar" data-controller="markdown-toolbar" data-markdown-toolbar-target-value="business_idea_description">
                    <button type="button" class="toolbar-btn" data-action="click->markdown-toolbar#insertHeading1" title="{{ 'app.toolbar.h1'|trans }}">{{ 'app.toolbar.h1'|trans }}</button>
                    <button type="button" class="toolbar-btn" data-action="click->markdown-toolbar#insertHeading2" title="{{ 'app.toolbar.h2'|trans }}">{{ 'app.toolbar.h2'|trans }}</button>
                    <button type="button" class="toolbar-btn" data-action="click->markdown-toolbar#insertBold" title="{{ 'app.toolbar.bold'|trans }}">{{ 'app.toolbar.bold'|trans }}</button>
                    <button type="button" class="toolbar-btn" data-action="click->markdown-toolbar#insertList" title="{{ 'app.toolbar.list'|trans }}">{{ 'app.toolbar.list'|trans }}</button>
                    <button type="button" class="toolbar-btn" data-action="click->markdown-toolbar#insertLink" title="{{ 'app.toolbar.link'|trans }}">{{ 'app.toolbar.link'|trans }}</button>
                </div>

                {{ form_widget(form.description, {'attr': {
                    'class': 'form-control form-textarea',
                    'placeholder': 'idea.description.placeholder'|trans,
                    'rows': 6,
                    'data-controller': 'textarea-autogrow',
                    'data-action': 'input->textarea-autogrow#autogrow'
                }}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-row-3 attachment-group">
                <div class="form-group">
                    {{ form_label(form.status) }}
                    {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.status) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.revenueModel) }}
                    {{ form_widget(form.revenueModel, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.revenueModel) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.targetAudience) }}
                    {{ form_widget(form.targetAudience, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.targetAudience) }}
                </div>
            </div>

            <div class="form-group attachment-group">
                {{ form_label(form.categories) }}
                {% if form.categories|length > 0 %}
                    <div class="category-checkboxes-wrapper">
                        {% for choice in form.categories %}
                            <div class="category-checkbox-item">
                                <label class="category-checkbox-label">
                                    {{ form_widget(choice) }} {{ form_label(choice) }}
                                </label>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <button type="button" class="btn-delete-category-small"
                                            onclick="if(confirm('{{ 'idea.categories.delete_confirm'|trans|escape('js') }}')) { const f = document.getElementById('global-delete-category-form'); f.action = '{{ path('app_category_delete', {'id': '0'}) }}'.replace('0', '{{ choice.vars.value }}'); document.getElementById('global-delete-category-token').value = '{{ csrf_token('delete' ~ choice.vars.value) }}'; f.submit(); }" 
                                            title="Supprimer">✕</button>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="category-empty-text">
                        {{ 'idea.categories.no_categories'|trans }}
                    </p>
                {% endif %}
                {{ form_errors(form.categories) }}
                {% do form.categories.setRendered() %}
            </div>

            <div class="form-group form-group-spaced">
                {{ form_label(form.new_categories) }}
                {{ form_widget(form.new_categories, {'attr': {'class': 'form-control', 'placeholder': 'idea.categories.new_help'|trans}}) }}
                <span class="form-help-text">{{ form.new_categories.vars.help|trans }}</span>
                {{ form_errors(form.new_categories) }}
            </div>

            <div class="form-group attachment-group form-group-spaced-lg">
                {{ form_label(form.attachmentFiles) }}
                <span class="attachment-help">{{ 'idea.attachment.help'|trans }}</span>

                {% if idea.attachmentFilenames is not empty %}
                    <div class="attachment-current-list">
                        <span class="attachment-current-label">{{ 'idea.attachment.current'|trans }} :</span>
                        {% for filename in idea.attachmentFilenames %}
                            <div class="attachment-current-item">
                                <a href="{{ asset('uploads/ideas/' ~ filename) }}" target="_blank" rel="noopener noreferrer" class="attachment-current-link">
                                    {{ filename|clean_filename }}
                                </a>
                                <label class="attachment-remove-label">
                                    <input type="checkbox" name="remove_attachments[]" value="{{ filename }}" class="attachment-remove-checkbox">
                                    {{ 'idea.attachment.remove'|trans }}
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {{ form_widget(form.attachmentFiles, {'attr': {'class': 'form-control-file', 'accept': 'image/jpeg,image/png,image/webp,application/pdf'}}) }}
                {{ form_errors(form.attachmentFiles) }}
            </div>
        </div>

        <div class="form-card">
            <div class="rating-header-sticky">
                <h2>{{ 'app.self_evaluation'|trans }}</h2>
                <div class="live-score-preview-box">
                    {{ 'app.rating_preview'|trans }} 
                    <span class="preview-number" data-live-rating-preview-target="preview">-</span>
                </div>
            </div>

            <div class="criteria-form-list">
                {% for child in form %}
                    {% if child.vars.name starts with 'rating_' %}
                        <div class="criterion-field-row">
                            <div class="criterion-label-col">
                                <label class="criterion-title-label">{{ child.vars.label|trans }}</label>
                                <span class="criterion-help-text">{{ child.vars.help|trans }}</span>
                            </div>
                            <div class="criterion-input-col">
                                <div class="stars-radio-group">
                                    {% for radio in child %}
                                        <label class="star-radio-label">
                                            {{ form_widget(radio, {'attr': {
                                                'data-action': 'change->live-rating-preview#update',
                                                'data-criterion': child.vars.name|replace({'rating_': ''}),
                                                'class': 'star-radio-input'
                                            }}) }}
                                            <span class="star-icon">★</span>
                                        </label>
                                    {% endfor %}
                                </div>

                                {% set criterionKey = child.vars.name|replace({'rating_': ''}) %}
                                {% set commentField = attribute(form, 'comment_' ~ criterionKey) %}
                                <div class="criterion-comment-box">
                                    {{ form_widget(commentField) }}
                                    {{ form_errors(commentField) }}
                                </div>
                            </div>
                        </div>
                        {% do child.setRendered() %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div class="form-actions-bar">
            <a href="{{ path('app_home') }}" class="btn btn-secondary btn-lg">{{ 'app.cancel'|trans }}</a>
            <button type="submit" class="btn btn-primary btn-lg">{{ 'app.save'|trans }}</button>
        </div>
    {{ form_end(form) }}
</div>
{% if is_granted('ROLE_ADMIN') %}
    <form id="global-delete-category-form" method="post" style="display: none;">
        <input type="hidden" name="_token" id="global-delete-category-token" value="">
    </form>
{% endif %}
{% endblock %}