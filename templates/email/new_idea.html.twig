<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ 'email.new_idea.title'|trans }}</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            border: 1px solid #e2e8f0;
        }
        .header {
            border-bottom: 2px solid #3b82f6;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #3b82f6;
        }
        h1 {
            font-size: 20px;
            margin-top: 0;
        }
        .idea-box {
            background-color: #f1f5f9;
            border-left: 4px solid #3b82f6;
            padding: 15px;
            border-radius: 0 8px 8px 0;
            margin: 20px 0;
        }
        .idea-title {
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 8px;
        }
        .btn {
            display: inline-block;
            background-color: #3b82f6;
            color: #ffffff !important;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: bold;
            margin-top: 15px;
            text-align: center;
        }
        .footer {
            margin-top: 30px;
            font-size: 12px;
            color: #64748b;
            text-align: center;
            border-top: 1px solid #e2e8f0;
            padding-top: 15px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <span class="logo">BizIdeas</span>
        </div>
        
        <h1>Bonjour,</h1>
        <p>{{ 'email.new_idea.intro'|trans({'%creator%': creator.email}) }}</p>
        
        <div class="idea-box">
            <div class="idea-title">{{ idea.title }}</div>
            <div>{{ idea.description|app_markdown }}</div>
        </div>
        
        <p>{{ 'email.new_idea.call_to_action'|trans }}</p>
        
        <a href="{{ rateUrl }}" class="btn">{{ 'email.new_idea.button'|trans }}</a>
        
        <div class="footer">
            <p>{{ 'email.footer'|trans }}</p>
        </div>
    </div>
</body>
</html>
