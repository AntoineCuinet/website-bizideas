{% extends 'base.html.twig' %}

{% block title %}{{ 'app.home'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="dashboard-container" data-controller="modal-manager">
    <!-- Header/Navigation Bar -->
    <header class="app-header">
        <div class="header-logo">
            <span class="logo-text"><a href="{{ path('app_home') }}">💡 {{ 'app.title'|trans }}</a></span>
        </div>
        <div class="header-nav">
            <!-- Collaborators Stats Dropdown -->
            <div class="header-dropdown-container">
                <button id="collaborators-toggle" class="btn btn-icon collaborators-btn" aria-label="{{ 'collaborators.title'|trans }}">
                    <span>ℹ️</span>
                </button>
                <div class="header-dropdown-menu">
                    <h4 class="dropdown-title">
                        <span>👥 {{ 'collaborators.title'|trans }}</span>
                        <span class="total-ideas-badge">{{ 'collaborators.total_ideas'|trans({'%count%': totalIdeas}) }}</span>
                    </h4>
                    <div class="dropdown-list">
                        {% for stat in collaboratorsStats %}
                            <div class="dropdown-item {% if stat.isCurrentUser %}dropdown-item-current{% endif %}">
                                <div class="dropdown-item-info">
                                    <span class="dropdown-item-avatar">
                                        {% if stat.isCurrentUser %}👤{% else %}✉️{% endif %}
                                    </span>
                                    <span class="dropdown-item-name" title="{{ stat.user.email }}">
                                        {{ stat.user.displayName }}
                                        {% if stat.isCurrentUser %}
                                            <span class="current-user-tag">({{ 'collaborators.me'|trans }})</span>
                                        {% endif %}
                                    </span>
                                </div>
                                <div class="dropdown-item-stats-badge" title="{{ 'collaborators.ideas_created'|trans({'%count%': stat.ideasCount}) }}">
                                    <span class="ideas-count-number">{{ stat.ideasCount }}</span>
                                    <span class="ideas-count-label">
                                        {% if stat.ideasCount > 1 %}
                                            {{ 'collaborators.ideas_label_plural'|trans }}
                                        {% else %}
                                            {{ 'collaborators.ideas_label_singular'|trans }}
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <button id="theme-toggle" class="btn btn-icon theme-btn" aria-label="Toggle theme">
                <span class="theme-icon-light">☀️</span>
                <span class="theme-icon-dark">🌙</span>
            </button>
            <a href="{{ path('app_account') }}" class="btn btn-secondary nav-link">
                <span class="nav-icon">👤</span>
                <span class="nav-text">{{ 'app.account'|trans }}</span>
            </a>
        </div>
    </header>

    <main class="dashboard-content">
        <!-- Filter / Export Toolbar -->
        <section class="toolbar-section">
            <div class="toolbar-sort">
                <label for="sort-select" class="sort-label">{{ 'app.sorting'|trans }} :</label>
                <div class="select-wrapper">
                    <select id="sort-select" class="sort-select" onchange="window.location.href = '?sort=' + this.value">
                        <option value="global_score" {% if sortBy == 'global_score' %}selected{% endif %}>{{ 'app.sorting.global_score'|trans }}</option>
                        <option value="last_added" {% if sortBy == 'last_added' %}selected{% endif %}>{{ 'app.sorting.last_added'|trans }}</option>
                        <option value="created_by_me" {% if sortBy == 'created_by_me' %}selected{% endif %}>{{ 'app.sorting.created_by_me'|trans }}</option>
                        <option value="created_by_other" {% if sortBy == 'created_by_other' %}selected{% endif %}>
                            {% if collaborators|length == 1 %}
                                {{ 'app.sorting.created_by_other_param'|trans({'%email%': collaborators[0].displayName}) }}
                            {% else %}
                                {{ 'app.sorting.created_by_other'|trans }}
                            {% endif %}
                        </option>
                        <option value="status" {% if sortBy == 'status' %}selected{% endif %}>{{ 'app.sorting.status'|trans }}</option>
                    </select>
                </div>
            </div>

            <div class="toolbar-export">
                <span class="export-label">📥 {{ 'app.export'|trans }} :</span>
                <div class="export-buttons">
                    <a href="?sort={{ sortBy }}&export=csv" class="btn btn-sm btn-outline">{{ 'app.export.csv'|trans }}</a>
                    <a href="?sort={{ sortBy }}&export=markdown" class="btn btn-sm btn-outline">{{ 'app.export.md'|trans }}</a>
                    <a href="?sort={{ sortBy }}&export=pdf" class="btn btn-sm btn-outline">{{ 'app.export.pdf'|trans }}</a>
                </div>
            </div>
        </section>

        <!-- Ideas List Grid -->
        <section class="ideas-section">
            <div class="ideas-grid">
                {% for item in rankedIdeas %}
                    {% set idea = item.idea %}
                    {% set globalScore = item.globalScore %}
                    {% set rank = item.rank %}
                    {% set isOwn = (idea.creator.id == app.user.id) %}

                    <div class="idea-card {% if isOwn %}idea-card-own{% else %}idea-card-other{% endif %}" 
                         data-action="click->modal-manager#open" 
                         data-idea-id="{{ idea.id }}">
                        
                        <div class="idea-card-header">
                            <span class="idea-badge-rank">#{{ rank }}</span>
                            <span class="idea-badge-status badge-{{ idea.status }}">{{ ('status.' ~ idea.status)|trans }}</span>
                        </div>

                        <h2 class="idea-card-title">{{ idea.title }}</h2>
                        
                        <p class="idea-card-creator">
                            {% if isOwn %}
                                {{ 'app.created_by'|trans({'%email%': 'Moi'}) }}
                            {% else %}
                                {{ 'app.created_by'|trans({'%email%': idea.creator.displayName}) }}
                            {% endif %}
                        </p>

                        <div class="idea-card-scores">
                            <div class="score-block">
                                <span class="score-title">{{ 'app.global_score'|trans }}</span>
                                <span class="score-value">
                                    {% if globalScore > 0 %}
                                        {{ 'app.global_score_display'|trans({'%score%': globalScore}) }}
                                    {% else %}
                                        {{ 'app.not_rated'|trans }}
                                    {% endif %}
                                </span>
                            </div>
                            
                            {% if item.ratingsData is not empty %}
                                <div class="individual-scores-list">
                                    {% for rData in item.ratingsData %}
                                        <div class="score-block-individual">
                                            <span class="score-title-individual">
                                                {% if rData.email == app.user.email %}
                                                    {{ 'app.user_score'|trans }}
                                                {% else %}
                                                    {{ 'app.other_score'|trans({'%email%': rData.displayName}) }}
                                                {% endif %} :
                                            </span>
                                            <span class="score-value-individual">
                                                {{ 'app.global_score_display'|trans({'%score%': rData.score}) }}
                                            </span>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="idea-card-meta">
                            <span class="meta-tag">{{ ('revenue.' ~ idea.revenueModel)|trans }}</span>
                            <span class="meta-tag">{{ ('audience.' ~ idea.targetAudience)|trans }}</span>
                        </div>

                        <div class="idea-card-actions" data-action="click->stop">
                            {% if isOwn %}
                                <a href="{{ path('app_idea_edit', {id: idea.id}) }}" class="btn btn-xs btn-primary">{{ 'app.button.edit'|trans }}</a>
                                <form action="{{ path('app_idea_delete', {id: idea.id}) }}" method="post" class="inline-form" onsubmit="return confirm('{{ 'app.delete_confirm'|trans }}')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ idea.id) }}">
                                    <button type="submit" class="btn btn-xs btn-danger">{{ 'app.button.delete'|trans }}</button>
                                </form>
                            {% else %}
                                {% set rating = idea.ratingByUser(app.user) %}
                                <a href="{{ path('app_idea_rate', {id: idea.id}) }}" class="btn btn-xs btn-accent">
                                    {% if rating %}{{ 'app.button.edit_note'|trans }}{% else %}{{ 'app.button.rate'|trans }}{% endif %}
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Idea Detail Modal Dialog -->
                    <dialog id="modal-{{ idea.id }}" class="idea-modal" data-modal-manager-target="modal" data-auto-open="{{ openIdeaItem and openIdeaItem.idea.id == idea.id ? 'true' : 'false' }}">
                        <div class="modal-content">
                            <div class="modal-header">
                                <span class="modal-rank">{{ 'app.rank_number'|trans({'%rank%': rank}) }}</span>
                                <button class="btn-close" data-action="click->modal-manager#close" data-idea-id="{{ idea.id }}">✕</button>
                            </div>
                            
                            <div class="modal-title-area">
                                <span class="idea-badge-status badge-{{ idea.status }}">{{ ('status.' ~ idea.status)|trans }}</span>
                                <h2>{{ idea.title }}</h2>
                                <p class="modal-meta-text">
                                    {{ 'app.sorting.created_by_and_date'|trans({'%email%': idea.creator.displayName, '%date%': idea.createdAt|date("d/m/Y")}) }}
                                </p>
                            </div>

                            <div class="modal-body">
                                <div class="modal-desc-box">
                                    {{ idea.description|nl2br }}
                                </div>

                                <div class="modal-info-grid">
                                    <div class="info-item">
                                        <span class="info-label">{{ 'app.revenue_model'|trans }}</span>
                                        <span class="info-val">{{ ('revenue.' ~ idea.revenueModel)|trans }}</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">{{ 'app.target_audience'|trans }}</span>
                                        <span class="info-val">{{ ('audience.' ~ idea.targetAudience)|trans }}</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">{{ 'app.global_score'|trans }}</span>
                                        <span class="info-val highlight">
                                            {% if globalScore > 0 %}{{ 'app.global_score_display'|trans({'%score%': globalScore}) }}{% else %}-{% endif %}
                                        </span>
                                    </div>
                                </div>

                                <div class="modal-ratings-comparison">
                                    <h3>{{ 'app.evaluation'|trans }}</h3>
                                    
                                    {% set allUsers = [app.user]|merge(collaborators) %}
                                    <div class="criteria-list">
                                        {% for cKey, cConfig in criteria %}
                                            <div class="criterion-row">
                                                <div class="criterion-info">
                                                    <span class="criterion-name">{{ cConfig.label|trans }}</span>
                                                    <span class="criterion-desc">{{ cConfig.description|trans }}</span>
                                                </div>
                                                <div class="criterion-scores">
                                                    {# Show creator rating #}
                                                    {% set creatorRating = idea.ratingByUser(idea.creator) %}
                                                    {% set creatorScore = creatorRating ? creatorRating.scoreFor(cKey) : null %}
                                                    {% set creatorIsMe = (idea.creator.id == app.user.id) %}
                                                    <div class="score-line">
                                                        <span class="score-line-label">{% if creatorIsMe %}{{ 'app.my_score'|trans }}{% else %}{{ 'app.other_score'|trans({'%email%': idea.creator.displayName}) }} :{% endif %}</span>
                                                        <div class="stars-display">
                                                            {% if creatorScore %}
                                                                {% for i in 1..5 %}
                                                                    <span class="star {% if i <= creatorScore %}star-filled{% endif %}">★</span>
                                                                {% endfor %}
                                                            {% else %}
                                                                <span class="star-none">-</span>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                    
                                                    {# Show other ratings (everyone except the creator) #}
                                                    {% for u in allUsers %}
                                                        {% if u.id != idea.creator.id %}
                                                            {% set r = idea.ratingByUser(u) %}
                                                            {% set uScore = r ? r.scoreFor(cKey) : null %}
                                                            {% set uIsMe = (u.id == app.user.id) %}
                                                            <div class="score-line">
                                                                <span class="score-line-label">{% if uIsMe %}{{ 'app.my_score'|trans }}{% else %}{{ 'app.other_score'|trans({'%email%': u.displayName}) }} :{% endif %}</span>
                                                                <div class="stars-display">
                                                                    {% if uScore %}
                                                                        {% for i in 1..5 %}
                                                                            <span class="star {% if i <= uScore %}star-filled-other{% endif %}">★</span>
                                                                        {% endfor %}
                                                                    {% else %}
                                                                        <span class="star-none">-</span>
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button class="btn btn-secondary" data-action="click->modal-manager#close" data-idea-id="{{ idea.id }}">{{ 'app.cancel'|trans }}</button>
                                {% if isOwn %}
                                    <a href="{{ path('app_idea_edit', {id: idea.id}) }}" class="btn btn-primary">✏️ {{ 'app.edit_idea'|trans }}</a>
                                {% else %}
                                    <a href="{{ path('app_idea_rate', {id: idea.id}) }}" class="btn btn-accent">
                                        {% if idea.ratingByUser(app.user) %}{{ 'app.button.edit_note'|trans }}{% else %}⭐ {{ 'app.rate_this_idea'|trans }}{% endif %}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </dialog>
                {% endfor %}
            </div>

            {% if rankedIdeas|length == 0 %}
                <div class="no-ideas-card">
                    <p>{{ 'app.no_ideas'|trans }}</p>
                </div>
            {% endif %}
        </section>
    </main>

    <!-- Floating Action Button -->
    <a href="{{ path('app_idea_new') }}" class="fab-btn" title="{{ 'app.add_idea'|trans }}">
        <span class="fab-icon">➕</span>
    </a>
</div>
{% endblock %}
