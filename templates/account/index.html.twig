{% extends 'base.html.twig' %}

{% block title %}{{ 'app.account'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="form-container">
    <div class="form-header">
        <a href="{{ path('app_home') }}" class="btn-back">← Retour</a>
        <h1>👤 {{ 'app.account'|trans }}</h1>
        <p class="form-subtitle">{{ 'app.account_header'|trans }}</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'standard-form'}}) }}
        <!-- Personal Information Card -->
        <div class="form-card">
            <h2>🔒 {{ 'app.account_info'|trans }}</h2>
            
            <div class="form-group">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="form-group">
                {{ form_label(form.pseudo) }}
                {{ form_widget(form.pseudo, {'attr': {'class': 'form-control', 'placeholder': 'Votre pseudo public...'}}) }}
                {{ form_errors(form.pseudo) }}
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control', 'autocomplete': 'new-password'}}) }}
                    {{ form_errors(form.plainPassword.first) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'autocomplete': 'new-password'}}) }}
                    {{ form_errors(form.plainPassword.second) }}
                </div>
            </div>
        </div>

        <!-- Preferences Card -->
        <div class="form-card">
            <h2>⚖️ {{ 'app.preferences'|trans }}</h2>
            <p class="section-help-text">{{ 'app.preferences_intro'|trans }}</p>

            <div class="preferences-grid">
                {% for child in form %}
                    {% if child.vars.name starts with 'pref_' %}
                        <div class="preference-field-row">
                            <div class="preference-info">
                                <label class="preference-title-label">{{ child.vars.label|trans }}</label>
                            </div>
                            <div class="preference-input">
                                {{ form_widget(child, {'attr': {'class': 'form-control preference-select-widget'}}) }}
                                {{ form_errors(child) }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions-bar">
            <a href="{{ path('app_home') }}" class="btn btn-secondary btn-lg">{{ 'app.cancel'|trans }}</a>
            <button type="submit" class="btn btn-primary btn-lg">💾 {{ 'app.save'|trans }}</button>
        </div>
    {{ form_end(form) }}

    <!-- Logout Option -->
    <div class="account-logout-box">
        <a href="{{ path('app_logout') }}" class="btn btn-danger btn-lg btn-logout-full">🚪 {{ 'app.logout'|trans }}</a>
    </div>
</div>
{% endblock %}
