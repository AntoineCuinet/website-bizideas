{% extends 'base.html.twig' %}

{% block title %}{{ 'app.account'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="form-container">
    <div class="form-header">
        <a href="{{ path('app_home') }}" class="btn-back">{{ 'app.back'|trans }}</a>
        <h1>{{ 'app.account'|trans }}</h1>
        <p class="form-subtitle">{{ 'app.account_header'|trans }}</p>
    </div>

    {{ form_start(infoForm, {'attr': {'class': 'standard-form'}}) }}
        <div class="form-card form-card-account">
            <h2>🔒 {{ 'app.account_info'|trans }}</h2>

            <div class="form-group">
                <p>{{ 'app.role'|trans }}: {% if 'ROLE_ADMIN' in app.user.roles %}{{ 'app.role_admin'|trans }}{% else %}{{ 'app.role_user'|trans }}{% endif %}</p>
            </div>

            <div class="form-group">
                {{ form_label(infoForm.email) }}
                {{ form_widget(infoForm.email, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(infoForm.email) }}
            </div>

            <div class="form-group">
                {{ form_label(infoForm.pseudo) }}
                {{ form_widget(infoForm.pseudo, {'attr': {'class': 'form-control', 'placeholder': 'Votre pseudo public...'}}) }}
                {{ form_errors(infoForm.pseudo) }}
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    {{ form_label(infoForm.plainPassword.first) }}
                    {{ form_widget(infoForm.plainPassword.first, {'attr': {'class': 'form-control', 'autocomplete': 'new-password'}}) }}
                    {{ form_errors(infoForm.plainPassword.first) }}
                </div>
                <div class="form-group">
                    {{ form_label(infoForm.plainPassword.second) }}
                    {{ form_widget(infoForm.plainPassword.second, {'attr': {'class': 'form-control', 'autocomplete': 'new-password'}}) }}
                    {{ form_errors(infoForm.plainPassword.second) }}
                </div>
            </div>

            <div class="form-actions-account">
                <button type="submit" class="btn btn-primary btn-lg">{{ 'app.save'|trans }}</button>
            </div>
        </div>
    {{ form_end(infoForm) }}

    {{ form_start(prefForm, {'attr': {'class': 'standard-form preferences-form'}}) }}
        <div class="form-card">
            <h2>⚖️ {{ 'app.preferences'|trans }}</h2>
            <p class="section-help-text">{{ 'app.preferences_intro'|trans }}</p>

            <div class="preferences-grid">
                {% for child in prefForm %}
                    {% if child.vars.name starts with 'pref_' %}
                        <div class="preference-field-row">
                            <div class="preference-info">
                                <label class="preference-title-label">{{ child.vars.label|trans }}</label>
                            </div>
                            <div class="preference-input">
                                {{ form_widget(child, {'attr': {'class': 'form-control preference-select-widget'}}) }}
                                {{ form_errors(child) }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            <div class="form-actions-account">
                <button type="submit" class="btn btn-primary btn-lg">{{ 'app.save'|trans }}</button>
            </div>
        </div>
    {{ form_end(prefForm) }}

    <div class="account-logout-box">
        <a href="{{ path('app_logout') }}" class="btn btn-danger btn-lg btn-logout-full">{{ 'app.logout'|trans }}</a>
    </div>

    {% if app_version() %}
        <div class="account-version-box">
            {{ 'app.version'|trans({'%version%': app_version()}) }}
        </div>
    {% endif %}
</div>
{% endblock %}